node_modules/
.next/
.env*
!.env.example
# Telegram MTProto StringSession: a bearer credential for the whole account.
.telegram.session
.vercel
*.log
.cache/
data/cache/
data/raw/
# operator artifacts (x-gap-rescore snapshots, rendered emails) — never committed
data/outbox/
# map-remap driver checkpoints (scan cursors; doc_map_state is the real record)
data/remap-state/
coverage/
.DS_Store

# TypeScript incremental-compile cache: machine-local, rewritten by every
# `tsc --noEmit` (so by every `npm run typecheck` and `next build`).
*.tsbuildinfo

# Isolated workstream checkouts (git worktrees for sandboxed agent work)
.workstream/
data/*.json

# Analysis-eval LIVE results are operator artifacts and are never committed;
# offline fixture results (no live- prefix) ARE committed as the sample
# baseline report inputs.
docs/evals/analysis/results/live-*
# Analysis-eval opt-in capture (EVAL_CAPTURE_DIR default location): local
# operator evidence — per-attempt accounting and optional raw output. Never committed.
docs/evals/analysis/capture/
